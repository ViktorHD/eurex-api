{
  "version": 1,
  "description": "Questions for evals/run_evals.py. Checks that need live data use answer_cites: some value of those fields from the tool results must appear in the answer.",
  "cases": [
    {
      "id": "find-fesx",
      "question": "What is the Eurex product code for Euro STOXX 50 index futures?",
      "expect": {
        "tools_any": [
          "search_products"
        ],
        "contains_any": [
          "FESX"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "find-oesx",
      "question": "Which product code do options on the Euro STOXX 50 have?",
      "expect": {
        "tools_any": [
          "search_products"
        ],
        "contains_any": [
          "OESX"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "find-fdax",
      "question": "What is the product code of DAX futures at Eurex?",
      "expect": {
        "tools_any": [
          "search_products"
        ],
        "contains_any": [
          "FDAX"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "find-fgbl",
      "question": "Which Eurex futures product is the Euro-Bund future (long term German government bond)?",
      "expect": {
        "tools_any": [
          "search_products"
        ],
        "contains_any": [
          "FGBL"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "find-isin",
      "question": "Which product has the ISIN DE0009652644 as underlying? Give code and name.",
      "expect": {
        "tools_any": [
          "search_products",
          "run_graphql"
        ],
        "datasets_all": [
          "ProductInfos"
        ],
        "answer_cites": [
          "Product"
        ]
      }
    },
    {
      "id": "find-missing",
      "question": "Tell me the contract size of the Eurex product with code ZZZZ.",
      "expect": {
        "tools_any": [
          "search_products",
          "get_product"
        ],
        "contains_any": [
          "not found",
          "no product",
          "doesn't exist",
          "does not exist",
          "no match",
          "could not find",
          "couldn't find",
          "not available",
          "no such"
        ]
      }
    },
    {
      "id": "card-currency",
      "question": "In which currency is the FESX future denominated and what is its tick size and tick value?",
      "expect": {
        "tools_any": [
          "get_product",
          "search_products"
        ],
        "contains_any": [
          "EUR"
        ],
        "answer_cites": [
          "TickSize",
          "TickValue"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "card-contract-size",
      "question": "What is the contract size of FDAX?",
      "expect": {
        "tools_any": [
          "get_product",
          "run_graphql"
        ],
        "answer_cites": [
          "ContractSize"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "card-settlement",
      "question": "Is FESX cash settled or physically delivered?",
      "expect": {
        "tools_any": [
          "get_product"
        ],
        "answer_cites": [
          "SettlementType"
        ],
        "datasets_all": [
          "ProductInfos"
        ]
      }
    },
    {
      "id": "card-underlying",
